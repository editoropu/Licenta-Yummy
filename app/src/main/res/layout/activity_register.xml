<?xml version="1.0" encoding="utf-8"?>
<!--
    Ecranul de înregistrare - construit după exact același tipar ca activity_login.xml:
    antet cu degrade verde + "sheet" alb rotunjit peste el.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_header_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ===== ANTET ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="56dp"
            android:paddingBottom="34dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp">

            <TextView
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:text="🍳"
                android:textSize="38sp"
                android:gravity="center"
                android:background="@drawable/login_logo_circle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:fontFamily="@font/courgette"
                android:textSize="42sp"
                android:textColor="?attr/colorOnPrimary"
                android:layout_marginTop="18dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_tagline"
                android:textSize="14sp"
                android:alpha="0.8"
                android:gravity="center"
                android:textColor="?attr/colorOnPrimary"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- ===== FORMULAR ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/login_sheet_bg"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="34dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Creează cont"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alătură-te comunității Yummy"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="26dp" />

            <TextView
                style="@style/Yummy.FieldLabel"
                android:text="EMAIL" />

            <EditText
                android:id="@+id/registerEmailEditText"
                style="@style/Yummy.Input"
                android:hint="nume@email.com"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress"
                android:layout_marginBottom="18dp" />

            <TextView
                style="@style/Yummy.FieldLabel"
                android:text="PAROLĂ" />

            <EditText
                android:id="@+id/registerPasswordEditText"
                style="@style/Yummy.Input"
                android:hint="minim 6 caractere"
                android:inputType="textPassword"
                android:autofillHints="newPassword"
                android:layout_marginBottom="18dp" />

            <TextView
                style="@style/Yummy.FieldLabel"
                android:text="CONFIRMĂ PAROLA" />

            <EditText
                android:id="@+id/confirmPasswordEditText"
                style="@style/Yummy.Input"
                android:hint="repetă parola"
                android:inputType="textPassword"
                android:autofillHints="newPassword"
                android:layout_marginBottom="30dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/registerButton"
                style="@style/Yummy.Button"
                android:text="Înregistrare" />

            <TextView
                android:id="@+id/goToLoginText"
                style="@style/Yummy.TextLink"
                android:text="Ai deja cont? Conectează-te"
                android:layout_marginTop="22dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
